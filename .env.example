# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Bot token from the Discord developer portal
DISCORD_TOK=your-bot-token-here

# ID of the Discord server (guild) the bot syncs slash commands to
SRV_ID=123456789012345678

# ID of the #intro channel whose messages set member nicknames
INTRO_CHNL=123456789012345678

# ID of the channel where command audit logs are posted
AUDIT_CHNL=123456789012345678
